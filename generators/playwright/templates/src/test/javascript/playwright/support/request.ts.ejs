import { APIRequestContext } from '@playwright/test';
import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'fs';
import { dirname } from 'path';

const getSessionFile = (username: string) => `playwright/.auth/${username}-session.txt`;

export interface JsonWebToken {
  id_token: string;
}

export async function getBearerToken(request: APIRequestContext, username: string, password: string): Promise<string> {
  const sessionFile = getSessionFile(username);

  if (existsSync(sessionFile)) {
    const authToken = readFileSync(sessionFile, 'utf-8');
    // validation
    const response = await request.get('/api/account', { headers: { authorization: `Bearer ${authToken}` } });
    if (response.status() === 200) {
      return authToken;
    }
  }

  const authenticationUrl = process.env['AUTHENTICATIONURL'];
  if (!authenticationUrl) {
    throw new Error('Environment variable AUTHENTICATIONURL is not set');
  }

  const response = await request.post(authenticationUrl, {
    data: { username, password },
  });
  if (response.status() !== 200) {
    throw new Error('Connection error: ' + response.statusText());
  }

  const token: JsonWebToken = await response.json();
  mkdirSync(dirname(sessionFile), { recursive: true });
  writeFileSync(sessionFile, token.id_token, 'utf-8');
  return token.id_token;
}
