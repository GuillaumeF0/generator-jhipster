import { expect, test as it } from '@fixtures/test';

it.describe('login page', () => {
  const username = process.env['LOGIN_USER'] ?? '<%= skipUserManagement && (applicationTypeMonolith || applicationTypeGateway) ? 'admin' : 'user' %>';
  const password = process.env['PASSWORD_USER'] ?? '<%= skipUserManagement && (applicationTypeMonolith || applicationTypeGateway) ? 'admin' : 'user' %>';

  it.beforeEach(async ({ page, navbar }) => {
    await page.goto('');
    await navbar.getAccountMenuLocator().click();
    await navbar.getLoginItemLocator().click();
  });

  it('greets with signin', async ({ loginPage }) => {
    await expect(loginPage.getTitleLoginLocator()).toBeVisible();
  });

<%_ if (clientFrameworkAngular) { _%>
  it('greets visiting /login directly', async ({ page, loginPage }) => {
    await page.goto('/login');
    await expect(loginPage.getTitleLoginLocator()).toBeVisible();
  });
<%_ } _%>

  it('requires username', async ({ page, loginPage }) => {
    const authenticateRequest = page.waitForResponse(
      response => response.request().method() === 'POST' && response.url().endsWith('/api/<% if (authenticationTypeSession) { %>authentication<% } else { %>authenticate<% } %>'),
    );

    await expect(loginPage.getPasswordLoginLocator()).toBeVisible();
    await loginPage.getPasswordLoginLocator().fill('a-password');
    await loginPage.getSubmitLoginLocator().click();
<%_ if (!clientFrameworkReact) { _%>
    expect((await authenticateRequest).status()).toEqual(<% if (authenticationTypeSession) { %>401<% } else { %>400<% } %>);
<%_ } _%>
    // login page should stay open when login fails
    await expect(loginPage.getTitleLoginLocator()).toBeVisible();
  });

  it('requires password', async ({ page, loginPage }) => {
    const authenticateRequest = page.waitForResponse(
      response => response.request().method() === 'POST' && response.url().endsWith('/api/<% if (authenticationTypeSession) { %>authentication<% } else { %>authenticate<% } %>'),
    );
    await expect(loginPage.getUsernameLoginLocator()).toBeVisible();
    await loginPage.getUsernameLoginLocator().fill('a-login');
    await loginPage.getSubmitLoginLocator().click();
<%_ if (!clientFrameworkReact) { _%>
    expect((await authenticateRequest).status()).toEqual(<% if (authenticationTypeSession) { %>401<% } else { %>400<% } %>);
    await expect(loginPage.getErrorLoginLocator()).toBeVisible();
<%_ } else { _%>
    // login page should stay open when login fails
    await expect(loginPage.getTitleLoginLocator()).toBeVisible();
<%_ } _%>
  });

  it('errors when password is incorrect', async ({ page, loginPage }) => {
    const authenticateRequest = page.waitForResponse(
      response => response.request().method() === 'POST' && response.url().endsWith('/api/<% if (authenticationTypeSession) { %>authentication<% } else { %>authenticate<% } %>'),
    );
    await expect(loginPage.getUsernameLoginLocator()).toBeVisible();
    await loginPage.getUsernameLoginLocator().fill(username);
    await expect(loginPage.getPasswordLoginLocator()).toBeVisible();
    await loginPage.getPasswordLoginLocator().fill('bad-password');
    await loginPage.getSubmitLoginLocator().click();
    expect((await authenticateRequest).status()).toEqual(401);
    await expect(loginPage.getErrorLoginLocator()).toBeVisible();
  });

  it('go to home page when successfully logs in', async ({ page, loginPage }) => {
    const authenticateRequest = page.waitForResponse(
      response => response.request().method() === 'POST' && response.url().endsWith('/api/<% if (authenticationTypeSession) { %>authentication<% } else { %>authenticate<% } %>'),
    );
    await expect(loginPage.getUsernameLoginLocator()).toBeVisible();
    await loginPage.getUsernameLoginLocator().fill(username);
    await expect(loginPage.getPasswordLoginLocator()).toBeVisible();
    await loginPage.getPasswordLoginLocator().fill(password);
    await loginPage.getSubmitLoginLocator().click();
    expect((await authenticateRequest).status()).toEqual(200);
    await expect(page).toHaveURL(url => new URL(url).hash === '');
  });
});
