  it.describe('/configuration', () => {
    it('should load the page', async ({ page, navbar }) => {
      navbar.getAdminMenuLocator().click();
      navbar.getAdminMenuItemLocator('configuration').click();
      await expect(page.getByRole('heading', { name: __jhiTransformTranslateRemoveHtml__('configuration.title'), exact: true })).toBeVisible();
    });
  });
<%_ } _%>

  it.describe('/docs', () => {
    it('should load the page', async ({ page, navbar }) => {
      const request = await page.request.get('/management/info', { headers: { Authorization: `Bearer ${token_admin}` } });
      const info = await request.json();
      if (info.activeProfiles.includes('api-docs')) {
        navbar.getAdminMenuLocator().click();
        navbar.getAdminMenuItemLocator('docs').click();
        await expect(page.locator('iframe[title="Swagger UI"]')).toBeVisible();
        // Wait iframe to load
        await page.waitForTimeout(500);
        const swaggerIframe = page.locator('iframe[title="Swagger UI"]').contentFrame().locator('body');
        await expect(swaggerIframe).not.toBeEmpty();
        await expect(swaggerIframe.locator('[id="swagger-ui"]')).toBeVisible({ timeout: 15000 });
        await expect(swaggerIframe.locator('[id="select"] > option')).not.toHaveCount(0);
        await expect(swaggerIframe.locator('[id="swagger-ui"]').locator('.information-container')).not.toHaveCount(0);
      }
    });
  });
<%_ if (communicationSpringWebsocket) { _%>

  it.describe('/tracker', () => {
    it('should load the page', async ({ page, navbar }) => {
      navbar.getAdminMenuLocator().click();
      navbar.getAdminMenuItemLocator('tracker').click();
      await expect(page.locator('[data-cy="trackerPageHeading"]')).toBeVisible();
      await expect(page.locator('[data-cy="trackerTable"] > tbody > tr')).toHaveCount(1);
    });
  });
<%_ } _%>
});
