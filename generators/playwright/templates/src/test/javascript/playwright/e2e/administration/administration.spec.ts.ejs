import { expect, test as it } from '@fixtures/test';

interface User {
  id?: number;
  login?: string;
  email?: string;
}

it.describe('/admin', () => {
  const token_admin = process.env.JWT_TOKEN_ADMIN!;
  it.beforeEach(async ({ page }) => {
    await page.goto('');
  });

<%_ if (generateUserManagement) { _%>
  it.describe('/user-management', () => {
    it('should load the page', async ({ navbar, administrationPage }) => {
      navbar.getAdminMenuLocator().click();
      navbar.getAdminMenuItemLocator('user-management').click();
      await expect(administrationPage.getUserManagementPageHeadingLocator()).toBeVisible();
    });
    it.describe.skip('/user-management CRUD', () => {
      const userManagementPageUrlPattern = new RegExp('/admin/user-management(\\?.*)?$');
      const userManagementPageUrl = '/admin/user-management';
      let user: User | undefined;

      it.afterEach(async ({ request }) => {
        if (user) {
          const deleteUserRequest = await request.delete(`/api/admin/users/${user.id}`, {
            headers: { Authorization: `Bearer ${token_admin}` },
            ignoreHTTPSErrors: true,
            failOnStatusCode: true,
          });
          expect(deleteUserRequest.ok()).toBeTruthy();
        }
      });

      it.describe('with existing value', () => {
        it.beforeEach(async ({ page, request }) => {
          const userSample: User = {
            login: `user${Math.floor(Math.random() * 1000000)}`,
            email: `user${Math.floor(Math.random() * 1000000)}@example.com`,
          };

          const postUserRequest = await request.post(`/api/admin/users`, {
            headers: { Authorization: `Bearer ${token_admin}` },
            data: userSample,
            ignoreHTTPSErrors: true,
            failOnStatusCode: false,
          });
          expect([201, 500]).toContain(postUserRequest.status());

          const getUserRequest = await request.get(`/api/admin/users/${userSample.login}`);

          user = await getUserRequest.json();
          await page.goto(userManagementPageUrl);
        });

        it('detail button click should load details User page', async ({ page }) => {
          await page.getByRole('button', { name: __jhiTransformTranslateRemoveHtml__('entity.action.view') }).last().click();
          await expect(page.getByRole('heading')).toBeVisible();

          const entitiesRequest = page.waitForResponse(
            response => response.request().method() === 'GET' && response.url().endsWith('/api/admin/users+(?*|)'),
          );

          await page.getByRole('button', { name: __jhiTransformTranslateRemoveHtml__('entity.action.back') }).click();
          expect((await entitiesRequest).status()).toEqual(200);
          expect(page.url()).toMatch(userManagementPageUrlPattern);
        });

        it('edit button click should load edit User page and go back', async ({ page }) => {
          await page.getByRole('button', { name: __jhiTransformTranslateRemoveHtml__('entity.action.edit') }).last().click();
          await expect(page.getByRole('heading', { name: __jhiTransformTranslateRemoveHtml__('userManagement.home.createOrEditLabel') })).toBeVisible();
          await expect(page.getByRole('button', { name: __jhiTransformTranslateRemoveHtml__('entity.action.save') })).toBeVisible();

          const entitiesRequest = page.waitForResponse(
            response => response.request().method() === 'GET' && response.url().endsWith('/api/admin/users+(?*|)'),
          );

          await page.getByRole('button', { name: __jhiTransformTranslateRemoveHtml__('entity.action.cancel') }).click();
          expect((await entitiesRequest).status()).toEqual(200);
          expect(page.url()).toMatch(userManagementPageUrlPattern);
        });

        it('edit button click should load edit User page and save', async ({ page }) => {
          await page.getByRole('button', { name: __jhiTransformTranslateRemoveHtml__('entity.action.edit') }).last().click();
          await expect(page.getByRole('heading', { name: __jhiTransformTranslateRemoveHtml__('userManagement.home.createOrEditLabel') })).toBeVisible();

          const entitiesRequest = page.waitForResponse(
            response => response.request().method() === 'GET' && response.url().endsWith('/api/admin/users+(?*|)'),
          );

          await page.getByRole('button', { name: __jhiTransformTranslateRemoveHtml__('entity.action.save') }).click();
          expect((await entitiesRequest).status()).toEqual(200);
          expect(page.url()).toMatch(userManagementPageUrlPattern);
        });

        it('last delete button click should delete instance of User', async ({ page }) => {
          await page.getByRole('button', { name: __jhiTransformTranslateRemoveHtml__('entity.action.delete') }).last().click();
          await expect(page.getByRole('heading', { name: __jhiTransformTranslateRemoveHtml__('entity.delete.title') })).toBeVisible();

          const deleteEntityRequest = page.waitForResponse(
            response => response.request().method() === 'DELETE' && response.url().endsWith('/api/admin/users/*'),
          );

          const entitiesRequest = page.waitForResponse(
            response => response.request().method() === 'GET' && response.url().endsWith('/api/admin/users+(?*|)'),
          );

          await page.getByRole('button', { name: __jhiTransformTranslateRemoveHtml__('entity.action.delete') }).last().click();
          expect((await deleteEntityRequest).status()).toEqual(204);
          expect((await entitiesRequest).status()).toEqual(200);
          expect(page.url()).toMatch(userManagementPageUrlPattern);

          user = undefined;
        });
      });
    });
  });
<%_ } _%>

<%_ if (withAdminUi) { _%>
  it.describe('/metrics', () => {
    it('should load the page', async ({ page, navbar }) => {
      navbar.getAdminMenuLocator().click();
