import { expect, test as it } from '@fixtures/test';
import { classInvalid, classValid } from '@support/constants';

it.describe('/account/password', () => {
  it('should be accessible through menu', async ({ page, navbar }) => {
    await page.goto('');
    await navbar.getAccountMenuLocator().click();
    await navbar.getPasswordItemLocator().click();
    await expect(page).toHaveURL(/\/account\/password$/);
  });

  it("requires current password", async ({ page, passwordPage }) => {
    await page.goto('/account/password');
    <%_ if (clientFrameworkReact) { _%>
    await passwordPage.getSubmitLocator().click();
    <%_ } _%>
    await expect(passwordPage.getCurrentPasswordLocator()).toContainClass(classInvalid);
    await passwordPage.getCurrentPasswordLocator().fill('wrong-current-password');
    await passwordPage.getCurrentPasswordLocator().blur();
    await expect(passwordPage.getCurrentPasswordLocator()).toContainClass(classValid);
  });

  it("requires new password", async ({ page, passwordPage }) => {
    await page.goto('/account/password');
    <%_ if (clientFrameworkReact) { _%>
    await passwordPage.getSubmitLocator().click();
    <%_ } _%>
    await expect(passwordPage.getNewPasswordLocator()).toContainClass(classInvalid);
    await passwordPage.getNewPasswordLocator().fill('jhipster');
    await passwordPage.getNewPasswordLocator().blur();
    await expect(passwordPage.getNewPasswordLocator()).toContainClass(classValid);
  });

  it("requires confirm new password", async ({ page, passwordPage }) => {
    await page.goto('/account/password');
    <%_ if (clientFrameworkReact) { _%>
    await passwordPage.getSubmitLocator().click();
    <%_ } _%>
    await passwordPage.getNewPasswordLocator().fill('jhipster');
    await expect(passwordPage.getConfirmPasswordLocator()).toContainClass(classInvalid);
    await passwordPage.getConfirmPasswordLocator().fill('jhipster');
    await passwordPage.getConfirmPasswordLocator().blur();
    await expect(passwordPage.getConfirmPasswordLocator()).toContainClass(classValid);
  });

  it("should fail to update password when using incorrect current password", async ({ page, passwordPage }) => {
    await page.goto('/account/password');
    await passwordPage.getCurrentPasswordLocator().fill('wrong-current-password');
    await passwordPage.getNewPasswordLocator().fill('jhipster');
    await passwordPage.getConfirmPasswordLocator().fill('jhipster');

    const passwordSaveRequest = page.waitForResponse(
      response => response.request().method() === 'POST' && response.url().endsWith('/api/account/change-password'),
    );

    await passwordPage.getSubmitLocator().click();
    expect((await passwordSaveRequest).status()).toEqual(400);
  });

  it("should be able to update password", async ({ page, passwordPage }) => {
    const password = process.env.PASSWORD_USER ?? 'user';
    await page.goto('/account/password');
    await passwordPage.getCurrentPasswordLocator().fill(password);
    await passwordPage.getNewPasswordLocator().fill(password);
    await passwordPage.getConfirmPasswordLocator().fill(password);

    const passwordSaveRequest = page.waitForResponse(
      response => response.request().method() === 'POST' && response.url().endsWith('/api/account/change-password'),
    );

    await passwordPage.getSubmitLocator().click();
    expect((await passwordSaveRequest).status()).toEqual(200);
  });
});
