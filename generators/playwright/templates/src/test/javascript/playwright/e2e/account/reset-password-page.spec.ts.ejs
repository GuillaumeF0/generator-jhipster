import { expect, test as it } from '@fixtures/test';
import { classInvalid, classValid } from '@support/constants';

it.describe('forgot your password', () => {
  const username = process.env['LOGIN_USER'] ?? 'user';

  it.beforeEach(async ({ page, loginPage, navbarPage }) => {
    await page.goto('');
    await navbarPage.getAccountMenuLocator().click();
    await navbarPage.getLoginItemLocator().click();
    await expect(loginPage.getUsernameLoginLocator()).toBeVisible();
    await loginPage.getUsernameLoginLocator().fill(username);
    await loginPage.getForgetYourPasswordLocator().click();
  });

  it('requires email', async ({ resetPasswordPage }) => {
    <%_ if (clientFrameworkReact) { _%>
    await resetPasswordPage.getSubmitInitResetPasswordLocator().click({ force: true });
    <%_ } _%>
    await expect(resetPasswordPage.getEmailResetPasswordLocator()).toContainClass(classInvalid);
    await resetPasswordPage.getEmailResetPasswordLocator().fill('user@gmail.com');
    <%_ if (clientFrameworkReact) { _%>
    await resetPasswordPage.getSubmitInitResetPasswordLocator().click({ force: true });
    <%_ } _%>
    await expect(resetPasswordPage.getEmailResetPasswordLocator()).toContainClass(classValid);
  });

  it('should be able to init reset password', async ({ page, resetPasswordPage }) => {
    await resetPasswordPage.getEmailResetPasswordLocator().fill('user@gmail.com');

    const initResetPasswordResponse = page.waitForResponse(
      response => response.request().method() === 'POST' && response.url().endsWith('/api/account/reset-password/init'),
    );

    await resetPasswordPage.getSubmitInitResetPasswordLocator().click({ force: true });
    expect((await initResetPasswordResponse).status()).toEqual(200);
  });
});
